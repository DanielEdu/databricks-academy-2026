# ─────────────────────────────────────────────────────────────────────────────
# Credenciales locales · databricks-academy-2026
# Plantilla sin secretos. Copiar a .env y rellenar. ESTE SÍ se commitea.
# Cargar en la shell con:  set -a && source .env && set +a
# ─────────────────────────────────────────────────────────────────────────────

# Databricks workspace
DATABRICKS_HOST=https://dbc-dfb14324-e95d.cloud.databricks.com
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Azure SQL — fuente transaccional de Wizard Bank
AZURE_SQL_SERVER=srv.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=wizardbank
AZURE_SQL_USER=wizadmin
AZURE_SQL_PASSWORD=

# DSN armado, listo para --dsn del generador de datos
AZURE_SQL_DSN="Driver={ODBC Driver 18 for SQL Server};Server=tcp:srv.database.windows.net,1433;Database=wizardbank;Uid=wizadmin;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;"
